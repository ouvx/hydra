  "description": "Shared ABSTRACT Hydra presets and parameter API for Ghost Arcade (AGPL).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
